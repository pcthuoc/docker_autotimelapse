# AutoTimelapse CM4 Agent Configuration

# Cấu hình Camera & MQTT Auth
CAMERA_CODE=CAM-EXAMPLE
MQTT_PASSWORD=replace-with-camera-password
MQTT_BROKER=mqtt.congnghetimelapse.com
MQTT_PORT=1883
SERVER_BASE=https://cloud.congnghetimelapse.com

# Cấu hình Quản lý Nguồn GPIO 16 trên CM4
POWER_GPIO_PIN=16
POWER_ACTIVE_HIGH=true
WARMUP_DELAY_SEC=10.0
ALWAYS_KEEP_POWER=false

# Cấu hình Chế độ Tiết kiệm Nguồn (Dành cho EC25 / Mạch nguồn độc lập)
# Khi bật AUTO_SHUTDOWN_AFTER_CAPTURE=true, CM4 sẽ tự động sync và poweroff sau khi chụp/upload xong để EC25 ngắt nguồn
AUTO_SHUTDOWN_AFTER_CAPTURE=false
AUTO_CAPTURE_ON_BOOT=false
SHUTDOWN_DELAY_SEC=3.0

# Cấu hình Telemetry & I2C Bus 1 (SHT20, ADS1115, EMC2301 Fan)
TELEMETRY_INTERVAL=30
I2C_BUS_ID=1
EMC2301_I2C_ADDR=0x2F
ADS1115_I2C_ADDR=0x49
ADS1115_SOLAR_CHANNEL=2
ADS1115_BATTERY_CHANNEL=3
BATTERY_VOLTAGE_SCALE=5.545
SOLAR_VOLTAGE_SCALE=5.545
FAN_TEMP_OFF=48.0
FAN_TEMP_MID=55.0
FAN_TEMP_HIGH=65.0

# Cấu hình Hàng Đợi Offline (Lưu đệm trong container)
OFFLINE_QUEUE_DIR=/app/offline_queue
OFFLINE_RETRY_INTERVAL=60

# Cấu hình Thư mục Dữ Liệu Persistent Ghi Đĩa trên CM4
# - Chế độ bình thường: ./data (tự động tạo ./data/offline_queue và ./data/portainer_data)
# - Chế độ đóng băng OS (OverlayFS): đổi duy nhất 1 biến thành phân vùng ghi thật /mnt/data
DATA_DIR=/mnt/data
