#!/usr/bin/env python3
"""
set_and_verify_real_cam.py — Điều khiển và kiểm thử TRỰC TIẾP 100% trên Canon EOS 6D qua USB PTP.
Hỗ trợ:
1. Chạy 1 thông số đơn: python3 set_and_verify_real_cam.py iso 100
2. Chạy vòng lặp quét TẤT CẢ choices của 1 thông số từ thấp đến cao:
   python3 set_and_verify_real_cam.py iso --sweep
3. Chạy quét toàn bộ tất cả thông số (Full Sweep Suite):
   python3 set_and_verify_real_cam.py --all-sweep
"""

import sys
import time
import os

GREEN = "\033[92m"
RED = "\033[91m"
YELLOW = "\033[93m"
CYAN = "\033[96m"
BOLD = "\033[1m"
RESET = "\033[0m"

def get_camera():
    import gphoto2 as gp
    cam = gp.Camera()
    cam.init()
    return cam

def sweep_single_param(camera, widget_name: str, delay_sec: float = 0.5):
    import gphoto2 as gp
    print(f"\n{BOLD}{CYAN}{'='*75}{RESET}")
    print(f"{BOLD}{CYAN}   QUÉT VÒNG LẶP CHO THÔNG SỐ: {widget_name.upper()} (TỪ THẤP ĐẾN CAO)   {RESET}")
    print(f"{BOLD}{CYAN}{'='*75}{RESET}\n")

    config = camera.get_config()
    try:
        widget = config.get_child_by_name(widget_name)
    except gp.GPhoto2Error as e:
        print(f"{RED}❌ Không tìm thấy widget '{widget_name}': {e}{RESET}")
        return

    orig_val = str(widget.get_value())
    readonly = widget.get_readonly()
    num_choices = widget.count_choices() if widget.get_type() in [gp.GP_WIDGET_RADIO, gp.GP_WIDGET_MENU] else 0
    choices = [widget.get_choice(i) for i in range(num_choices)]

    print(f"[*] Giá trị ban đầu trên máy : {YELLOW}{BOLD}{orig_val}{RESET}")
    print(f"[*] Quyền ghi                : {'✅ Cho phép Ghi' if not readonly else '🔒 Chỉ đọc (Read-only)'}")
    print(f"[*] Tổng số giá trị choices  : {BOLD}{num_choices} choices{RESET}\n")

    if readonly:
        print(f"{YELLOW}⚠️  Thông số này là Read-only, không thể Set.{RESET}\n")
        return

    if not choices:
        print(f"{YELLOW}⚠️  Không có danh sách choices để quét.{RESET}\n")
        return

    passed_count = 0
    total_count = len(choices)

    for idx, choice_val in enumerate(choices, start=1):
        print(f"{BOLD}[{idx:02d}/{total_count:02d}] ➔ Đang SET {widget_name.upper()} = '{choice_val}'...{RESET}", end="", flush=True)
        try:
            # 1. SET
            cfg = camera.get_config()
            w = cfg.get_child_by_name(widget_name)
            w.set_value(str(choice_val))
            camera.set_config(cfg)

            # Chờ máy ảnh cập nhật
            time.sleep(delay_sec)

            # 2. PULL VERIFY
            v_cfg = camera.get_config()
            v_w = v_cfg.get_child_by_name(widget_name)
            actual_val = str(v_w.get_value()).strip()

            if actual_val.lower() == str(choice_val).strip().lower() or actual_val == str(choice_val):
                print(f" ➔ PULL lại: {GREEN}{BOLD}'{actual_val}' [✓ KHỚP 100%]{RESET}")
                passed_count += 1
            else:
                print(f" ➔ PULL lại: {RED}'{actual_val}' [❌ LỆCH SO VỚI '{choice_val}']{RESET}")

        except gp.GPhoto2Error as err:
            print(f" ➔ {RED}❌ Lỗi gphoto2: {err}{RESET}")

    # Khôi phục giá trị ban đầu
    print(f"\n[*] Đang khôi phục {widget_name.upper()} về giá trị ban đầu: '{orig_val}'...")
    try:
        cfg = camera.get_config()
        w = cfg.get_child_by_name(widget_name)
        w.set_value(str(orig_val))
        camera.set_config(cfg)
        print(f"{GREEN}✓ Đã khôi phục thành công về '{orig_val}'!{RESET}")
    except Exception as e:
        print(f"{YELLOW}⚠️  Không thể khôi phục: {e}{RESET}")

    print(f"\n{BOLD}{GREEN}🎉 HOÀN TẤT QUÉT {widget_name.upper()}: {passed_count}/{total_count} CHOICES XÁC THỰC THÀNH CÔNG!{RESET}\n")

def set_single_value(camera, widget_name: str, new_value: str):
    import gphoto2 as gp
    print(f"\n{BOLD}{CYAN}{'='*70}{RESET}")
    print(f"{BOLD}{CYAN}   SET THÔNG SỐ ĐƠN: {widget_name.upper()} ➔ '{new_value}'   {RESET}")
    print(f"{BOLD}{CYAN}{'='*70}{RESET}\n")

    config = camera.get_config()
    try:
        widget = config.get_child_by_name(widget_name)
        current_val = str(widget.get_value())
        print(f"[*] Giá trị hiện tại trên máy : {YELLOW}{BOLD}{current_val}{RESET}")
        print(f"[*] Đang ghi giá trị mới      : {CYAN}{BOLD}{new_value}{RESET}...")

        widget.set_value(str(new_value))
        camera.set_config(config)
        print(f"  {GREEN}✓ Lệnh ghi đã gửi thành công!{RESET}")

        time.sleep(0.3)
        print(f"[*] Đang PULL lại từ máy ảnh để xác thực...")
        v_cfg = camera.get_config()
        v_w = v_cfg.get_child_by_name(widget_name)
        actual_val = str(v_w.get_value())

        print(f"  • Giá trị PULL thực tế       : {GREEN}{BOLD}{actual_val}{RESET}")
        if actual_val.lower() == str(new_value).lower() or actual_val == str(new_value):
            print(f"\n{GREEN}{BOLD}🎉 THÀNH CÔNG! Máy ảnh Canon 6D đã thực sự chuyển sang '{actual_val}'.{RESET}\n")
        else:
            print(f"\n{RED}❌ LỆCH: Yêu cầu '{new_value}', máy trả về '{actual_val}'.{RESET}\n")
    except gp.GPhoto2Error as e:
        print(f"{RED}❌ Lỗi: {e}{RESET}\n")

def sweep_all_writable_params(camera, delay_sec: float = 0.3):
    test_params = [
        "iso",
        "aperture",
        "shutterspeed",
        "whitebalance",
        "imageformat",
        "capturetarget",
        "drivemode",
        "meteringmode",
        "highisonr"
    ]
    print(f"\n{BOLD}{CYAN}{'='*75}{RESET}")
    print(f"{BOLD}{CYAN}   BẮT ĐẦU CHẠY TOÀN BỘ MA TRẬN TẤT CẢ THÔNG SỐ (FULL SWEEP)   {RESET}")
    print(f"{BOLD}{CYAN}{'='*75}{RESET}\n")

    for p in test_params:
        sweep_single_param(camera, p, delay_sec=delay_sec)
        time.sleep(0.5)

def main():
    try:
        import gphoto2 as gp
    except ImportError:
        print(f"{RED}Lỗi: Thư viện python-gphoto2 chưa sẵn sàng.{RESET}")
        return

    try:
        print("[*] Đang kết nối tới Canon 6D qua USB PTP...")
        camera = get_camera()
        print(f"{GREEN}✓ Kết nối thành công tới máy ảnh vật lý!{RESET}")
    except gp.GPhoto2Error as e:
        print(f"{RED}❌ Lỗi kết nối Canon 6D: {e}{RESET}")
        return

    try:
        if len(sys.argv) == 1:
            # Mặc định quét ISO từ thấp đến cao
            sweep_single_param(camera, "iso", delay_sec=0.3)
        elif sys.argv[1] in ["--all-sweep", "-a", "all"]:
            sweep_all_writable_params(camera, delay_sec=0.3)
        elif len(sys.argv) == 2:
            param = sys.argv[1]
            sweep_single_param(camera, param, delay_sec=0.3)
        elif len(sys.argv) >= 3:
            param = sys.argv[1]
            val = sys.argv[2]
            if val in ["--sweep", "-s", "sweep", "all"]:
                delay = float(sys.argv[3]) if len(sys.argv) > 3 else 0.3
                sweep_single_param(camera, param, delay_sec=delay)
            else:
                set_single_value(camera, param, val)
    finally:
        try:
            camera.exit()
            print("[*] Đã ngắt kết nối an toàn.")
        except Exception:
            pass

if __name__ == "__main__":
    main()
