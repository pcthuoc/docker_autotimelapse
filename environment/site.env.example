# ── Site Domain & Information ─────────────────────────────────
SITE_DOMAIN=cloud.congnghetimelapse.com
SITE_SCHEME=http
SITE_NAME=AutoTimelapse Cloud

# ── Django Core Settings ──────────────────────────────────────
SECRET_KEY=generate_cryptographically_secure_random_key_here
DEBUG=0
ALLOWED_HOSTS=cloud.congnghetimelapse.com,localhost,127.0.0.1,site
CSRF_TRUSTED_ORIGINS=https://cloud.congnghetimelapse.com,http://cloud.congnghetimelapse.com

# ── Database (PostgreSQL) ──────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=autotimelapse
DB_USER=atl_user
DB_PASSWORD=your_db_password_here

POSTGRES_DB=autotimelapse
POSTGRES_USER=atl_user
POSTGRES_PASSWORD=your_db_password_here

# ── Redis & Celery ──────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── MQTT Broker (Mosquitto) ──────────────────────────────────
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASS=your_mqtt_password_here
MOSQUITTO_DYNSEC_PASSWORD=your_mqtt_password_here
MQTT_SKIP_ACL_SETUP=0
MQTT_ENABLED=1

# ── SeaweedFS / Storage ─────────────────────────────────────
SEAWEED_ENDPOINT_URL=http://seaweed-filer:8333
SEAWEED_PUBLIC_ENDPOINT_URL=http://cloud.congnghetimelapse.com:8333
SEAWEED_ACCESS_KEY=your_seaweed_access_key
SEAWEED_SECRET_KEY=your_seaweed_secret_key
SEAWEED_BUCKET=media
